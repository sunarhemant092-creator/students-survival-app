{"step_index":187,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-30T06:13:53Z","content":"Created At: 2026-09-30T11:43:53+05:30\nCompleted At: 2026-09-30T11:43:53+05:30\nFile Path: `file:///C:/Users/DELL/.gemini/antigravity/scratch/student-survival-app/app.js`\nTotal Lines: 3146\nTotal Bytes: 122878\nShowing lines 500 to 750\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n500:     }, 3200);\n501:   }\n502: \n503:   // ==========================================\n504:   // 5. SPLASH SCREEN LIFECYCLE (2-3 seconds)\n505:   // ==========================================\n506:   let splashTimer = null;\n507:   let splashQuoteInterval = null;\n508: \n509:   function initSplash() {\n510:     const splashScreen = document.getElementById('splash-screen');\n511:     const progressBar = document.getElementById('splash-progress-bar');\n512:     const progressPercent = document.getElementById('splash-progress-percent');\n513:     const quoteEl = document.getElementById('splash-quote');\n514:     const statusText = document.getElementById('splash-status-text');\n515: \n516:     if (!splashScreen) return;\n517: \n518:     let progress = 0;\n519:     let messageIndex = 0;\n520: \n521:     // Cycle funny student messages\n522:     splashQuoteInterval = setInterval(() => {\n523:       if (quoteEl) {\n524:         messageIndex = (messageIndex + 1) % FUNNY_SPLASH_MESSAGES.length;\n525:         quoteEl.style.opacity = '0';\n526:         setTimeout(() => {\n527:           quoteEl.textContent = FUNNY_SPLASH_MESSAGES[messageIndex];\n528:           quoteEl.style.opacity = '1';\n529:         }, 150);\n530:       }\n531:     }, 750);\n532: \n533:     const stepDuration = 25; // 25ms * 100 = 2500ms = 2.5 seconds total\n534:     splashTimer = setInterval(() => {\n535:       progress += 1;\n536:       if (progressBar) progressBar.style.width = `${progress}%`;\n537:       if (progressPercent) progressPercent.textContent = `${progress}%`;\n538: \n539:       if (progress === 30 && statusText) statusText.textContent = 'Calculating attendance shortage...';\n540:       if (progress === 60 && statusText) statusText.textContent = 'Checking pending deadlines...';\n541:       if (progress === 85 && statusText) statusText.textContent = 'Summoning survival spirit 🔥';\n542: \n543:       if (progress >= 100) {\n544:         clearInterval(splashTimer);\n545:         clearInterval(splashQuoteInterval);\n546:         dismissSplash();\n547:       }\n548:     }, stepDuration);\n549:   }\n550: \n551:   function skipSplash() {\n552:     if (splashTimer) clearInterval(splashTimer);\n553:     if (splashQuoteInterval) clearInterval(splashQuoteInterval);\n554:     dismissSplash();\n555:   }\n556: \n557:   function dismissSplash() {\n558:     const splashScreen = document.getElementById('splash-screen');\n559:     if (!splashScreen) return;\n560: \n561:     splashScreen.style.opacity = '0';\n562:     splashScreen.style.transition = 'opacity 0.4s ease-out';\n563: \n564:     setTimeout(() => {\n565:       splashScreen.classList.add('hidden');\n566:       if (state.student.isLoggedIn) {\n567:         showMainApp();\n568:       } else {\n569:         showAuthScreen();\n570:       }\n571:     }, 400);\n572:   }\n573: \n574:   // ==========================================\n575:   // 6. AUTHENTICATION & LOGIN (SIGN IN, CREATE ACCOUNT, DEMO LOGINS)\n576:   // ==========================================\n577:   function showAuthScreen() {\n578:     const authScreen = document.getElementById('auth-screen');\n579:     const mainApp = document.getElementById('main-app');\n580:     if (authScreen) authScreen.classList.remove('hidden');\n581:     if (mainApp) mainApp.classList.add('hidden');\n582: \n583:     // Pre-populate if saved in state\n584:     const idInput = document.getElementById('login-identifier');\n585:     const passInput = document.getElementById('login-password');\n586:     const rememberCheckbox = document.getElementById('login-remember');\n587: \n588:     if (idInput) idInput.value = state.student.username || state.student.email || 'aman_sharma';\n589:     if (passInput) passInput.value = state.student.password || 'password123';\n590:     if (rememberCheckbox) rememberCheckbox.checked = state.student.rememberMe !== false;\n591: \n592:     switchAuthTab('signin');\n593:   }\n594: \n595:   function switchAuthTab(tab) {\n596:     playSound('click');\n597:     const tabSignIn = document.getElementById('tab-auth-signin');\n598:     const tabSignUp = document.getElementById('tab-auth-signup');\n599:     const panelSignIn = document.getElementById('auth-panel-signin');\n600:     const panelSignUp = document.getElementById('auth-panel-signup');\n601: \n602:     if (tab === 'signin') {\n603:       if (tabSignIn) tabSignIn.classList.add('active');\n604:       if (tabSignUp) tabSignUp.classList.remove('active');\n605:       if (panelSignIn) panelSignIn.classList.remove('hidden');\n606:       if (panelSignUp) panelSignUp.classList.add('hidden');\n607:     } else {\n608:       if (tabSignUp) tabSignUp.classList.add('active');\n609:       if (tabSignIn) tabSignIn.classList.remove('active');\n610:       if (panelSignUp) panelSignUp.classList.remove('hidden');\n611:       if (panelSignIn) panelSignIn.classList.add('hidden');\n612:     }\n613:   }\n614: \n615:   function handleLogin(event) {\n616:     if (event) event.preventDefault();\n617:     playSound('click');\n618: \n619:     const idInput = document.getElementById('login-identifier');\n620:     const passInput = document.getElementById('login-password');\n621:     const rememberCheckbox = document.getElementById('login-remember');\n622: \n623:     const identifier = idInput ? idInput.value.trim().toLowerCase() : '';\n624:     const password = passInput ? passInput.value.trim() : '';\n625:     const remember = rememberCheckbox ? rememberCheckbox.checked : true;\n626: \n627:     if (!identifier) {\n628:       showToast('Please enter your username or college email! 👤', 'warning');\n629:       return;\n630:     }\n631: \n632:     // Check demo accounts first\n633:     const demoFound = DEFAULT_INDIAN_STUDENTS.find(s => \n634:       s.username.toLowerCase() === identifier || s.email.toLowerCase() === identifier\n635:     );\n636: \n637:     // Check registered accounts\n638:     const registeredFound = (state.registeredUsers || []).find(u => \n639:       (u.username && u.username.toLowerCase() === identifier) || (u.email && u.email.toLowerCase() === identifier)\n640:     );\n641: \n642:     const user = demoFound || registeredFound;\n643: \n644:     if (user) {\n645:       state.student = {\n646:         ...state.student,\n647:         name: user.name,\n648:         username: user.username,\n649:         email: user.email,\n650:         password: user.password,\n651:         college: user.college || state.student.college,\n652:         branch: user.branch || state.student.branch,\n653:         semester: user.semester || state.student.semester,\n654:         target: user.target || 75,\n655:         isLoggedIn: true,\n656:         rememberMe: remember,\n657:       };\n658: \n659:       if (user.subjects && user.subjects.length) {\n660:         state.subjects = JSON.parse(JSON.stringify(user.subjects));\n661:       }\n662:     } else {\n663:       // Allow custom guest login with typed identifier\n664:       const cleanName = identifier.includes('@') ? identifier.split('@')[0] : identifier;\n665:       const formattedName = cleanName.charAt(0).toUpperCase() + cleanName.slice(1);\n666:       state.student = {\n667:         ...state.student,\n668:         name: formattedName,\n669:         username: identifier,\n670:         email: identifier.includes('@') ? identifier : `${identifier}@college.edu`,\n671:         password: password || 'pass123',\n672:         isLoggedIn: true,\n673:         rememberMe: remember,\n674:       };\n675:     }\n676: \n677:     saveState();\n678:     playSound('success');\n679: \n680:     showToast(`Welcome back, ${state.student.name}! 👋 Ready to survive another day? 🔥`, 'success');\n681:     showToast(`“Your assignments missed you. 😭”`, 'warning');\n682: \n683:     showMainApp();\n684:   }\n685: \n686:   function handleSignUp(event) {\n687:     if (event) event.preventDefault();\n688:     playSound('click');\n689: \n690:     const name = document.getElementById('signup-name').value.trim();\n691:     const username = document.getElementById('signup-username').value.trim().toLowerCase();\n692:     const email = document.getElementById('signup-email').value.trim().toLowerCase();\n693:     const password = document.getElementById('signup-password').value;\n694:     const confirmPassword = document.getElementById('signup-confirm-password').value;\n695:     const college = document.getElementById('signup-college').value.trim();\n696:     const branch = document.getElementById('signup-branch').value;\n697:     const semester = document.getElementById('signup-semester').value;\n698:     const target = parseInt(document.getElementById('signup-target').value, 10) || 75;\n699: \n700:     if (!name || !username || !email || !password) {\n701:       showToast('Please fill in all required fields! ✍️', 'warning');\n702:       return;\n703:     }\n704: \n705:     if (password !== confirmPassword) {\n706:       playSound('alert');\n707:       showToast('Passwords do not match! Please check again 🔒', 'danger');\n708:       return;\n709:     }\n710: \n711:     // Check if username or email already registered\n712:     const exists = (state.registeredUsers || []).some(u => u.username === username || u.email === email);\n713:     if (exists) {\n714:       showToast('An account with this username/email already exists! Please sign in 🔑', 'warning');\n715:       switchAuthTab('signin');\n716:       return;\n717:     }\n718: \n719:     const newUser = {\n720:       name,\n721:       username,\n722:       email,\n723:       password,\n724:       college,\n725:       branch,\n726:       semester,\n727:       target,\n728:     };\n729: \n730:     if (!state.registeredUsers) state.registeredUsers = [];\n731:     state.registeredUsers.push(newUser);\n732: \n733:     // Set as active student\n734:     state.student = {\n735:       ...state.student,\n736:       name,\n737:       username,\n738:       email,\n739:       password,\n740:       college,\n741:       branch,\n742:       semester,\n743:       target,\n744:       isLoggedIn: true,\n745:       rememberMe: true,\n746:     };\n747: \n748:     saveState();\n749:     playSound('success');\n750: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
