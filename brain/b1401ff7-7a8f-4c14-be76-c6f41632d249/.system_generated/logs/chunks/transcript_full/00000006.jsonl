:     if (!state.student.soundEnabled) return;\n355:     try {\n356:       const ctx = getAudioContext();\n357:       if (!ctx) return;\n358: \n359:       const now = ctx.currentTime;\n360:       const osc = ctx.createOscillator();\n361:       const gain = ctx.createGain();\n362:       osc.connect(gain);\n363:       gain.connect(ctx.destination);\n364: \n365:       if (type === 'click') {\n366:         // Crisp subtle tap\n367:         osc.type = 'sine';\n368:         osc.frequency.setValueAtTime(600, now);\n369:         osc.frequency.exponentialRampToValueAtTime(300, now + 0.05);\n370:         gain.gain.setValueAtTime(0.15, now);\n371:         gain.gain.exponentialRampToValueAtTime(0.01, now + 0.05);\n372:         osc.start(now);\n373:         osc.stop(now + 0.05);\n374:       } else if (type === 'success') {\n375:         // High celebratory victory chime\n376:         osc.type = 'triangle';\n377:         osc.frequency.setValueAtTime(523.25, now); // C5\n378:         osc.frequency.setValueAtTime(659.25, now + 0.08); // E5\n379:         osc.frequency.setValueAtTime(783.99, now + 0.16); // G5\n380:         osc.frequency.setValueAtTime(1046.50, now + 0.24); // C6\n381:         gain.gain.setValueAtTime(0.2, now);\n382:         gain.gain.exponentialRampToValueAtTime(0.01, now + 0.45);\n383:         osc.start(now);\n384:         osc.stop(now + 0.45);\n385:       } else if (type === 'alert') {\n386:         // Soft cautionary beep\n387:         osc.type = 'sawtooth';\n388:         osc.frequency.setValueAtTime(320, now);\n389:         osc.frequency.setValueAtTime(280, now + 0.1);\n390:         gain.gain.setValueAtTime(0.12, now);\n391:         gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2);\n392:         osc.start(now);\n393:         osc.stop(now + 0.2);\n394:       } else if (type === 'alarm') {\n395:         // Gentle alarm bell\n396:         osc.type = 'sine';\n397:         osc.frequency.setValueAtTime(880, now);\n398:         osc.frequency.setValueAtTime(1174