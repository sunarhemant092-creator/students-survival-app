sm:items-center justify-between gap-4 shadow-xl\">\n          <div>\n            <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/20 border border-rose-400/30 text-rose-300 text-xs font-bold mb-2\">\n              <span>Deadlines Approach Faster Than They Appear</span>\n            </div>\n            <h2 class=\"text-2xl sm:text-3xl font-black font-heading text-white flex items-center gap-2\">\n              <span>📝</span> Assignment Countdown\n            </h2>\n            <p class=\"text-xs sm:text-sm text-slate-300 mt-1\">\n              Track university submissions sorted automatically by closest deadline.\n            </p>\n          </div>\n          <div class=\"flex items-center gap-2\">\n            <button onclick=\"App.openAddAssignmentModal()\" class=\"py-2.5 px-4 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs shadow-lg shadow-rose-600/30 transition flex items-center gap-1.5 active:scale-95\">\n              <span>➕</span> Add Assignment\n            </button>\n          </div>\n        </div>\n\n        <!-- Filter Pills -->\n        <div class=\"flex flex-wrap items-center gap-2\">\n          <button onclick=\"App.filterAssignments('all')\" data-assign-filter=\"all\" class=\"assign-filter-btn active px-3.5 py-1.5 rounded-xl text-xs font-bold bg-indigo-600 text-white transition\">\n            All Assignments\n          </button>\n          <button onclick=\"App.filterAssignments('urgent')\" data-assign-filter=\"urgent\" class=\"assign-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold bg-white/10 hover:bg-white/15 text-slate-300 transition\">\n            🔥 Due Today / Soon\n          </button>\n          <button onclick=\"App.filterAssignments('pending')\" data-assign-filter=\"pending\" class=\"assign-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold bg-white/10 hover:bg-white/15 text-slate-300 transition\">\n            ⏳ Pending\n          </button>\n          <button onclick=\"App.filterAssignments('completed')\" data-assign-filter=\"completed\" class=\"assign-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold bg-white/10 hover:bg-white/15 text-slate-300 transition\">\n            ✅ Completed\n          </button>\n        </div>\n\n        <!-- Assignments List -->\n        <div id=\"assignments-list\" class=\"space-y-3.5\">\n          <!-- Populated by JavaScript -->\n        </div>\n\n      </section>\n\n      <!-- ====================================================== -->\n      <!-- 🍔 PAGE 4: CANTEEN STATUS -->\n      <!-- ====================================================== -->\n      <section id=\"page-canteen\" class=\"page-section hidden space-y-6 animate-fade-in\">\n        \n        <!-- Hero Canteen Status Card -->\n        <div class=\"glass-card rounded-3xl p-6 sm:p-8 border border-white/15 backdrop-blur-xl relative overflow-hidden shadow-2xl\">\n          <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-6\">\n            <div>\n              <div class=\"flex items-center gap-3 mb-2\">\n                <span class=\"text-3xl\">🍔</span>\n                <h2 class=\"text-2xl sm:text-4xl font-black font-heading text-white\">\n                  CANTEEN STATUS\n                </h2>\n              </div>\n              <p class=\"text-xs sm:text-sm text-slate-300 font-medium\">\n                Campus Fuel Station • Operating Hours: <span class=\"text-white font-bold\">08:00 AM – 06:00 PM</span>\n              </p>\n\n              <!-- Funny Message -->\n              <div class=\"mt-4 p-3.5 rounded-2xl bg-white/10 border border-white/15 inline-block\">\n                <div id=\"canteen-funny-message\" class=\"text-sm sm:text-base font-extrabold text-amber-300\">\n                  “🍔 Your wallet is in danger.”\n                </div>\n              </div>\n            </div>\n\n            <!-- Canteen Status Toggle & Live Badge -->\n            <div class=\"flex-shrink-0 flex flex-col items-center sm:items-end justify-center gap-3\">\n              <div id=\"canteen-hero-badge\" class=\"px-6 py-3 rounded-2xl text-xl sm:text-2xl font-black font-heading bg-emerald-500/20 text-emerald-300 border-2 border-emerald-500/40 shadow-xl flex items-center gap-2\">\n                <span class=\"w-3.5 h-3.5 rounded-full bg-emerald-400 animate-pulse\"></span>\n                <span id=\"canteen-hero-text\">🟢 OPEN</span>\n              </div>\n\n              <!-- Interactive Switch -->\n              <div class=\"flex items-center gap-2 bg-slate-900/60 p-2 rounded-2xl border border-white/10\">\n                <span class=\"text-xs font-bold text-slate-300\">Canteen Toggle:</span>\n                <button onclick=\"App.toggleCanteenStatus()\" id=\"canteen-toggle-action-btn\" class=\"px-3 py-1 rounded-xl text-xs font-black bg-indigo-600 hover:bg-indigo-500 text-white transition\">\n                  Switch to CLOSED\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Canteen Menu Section -->\n        <div>\n          <div class=\"flex items-center justify-between mb-4\">\n            <div>\n              <h3 class=\"font-heading font-black text-xl text-white flex items-center gap-2\">\n                <span>🍜</span> Official Student Survival Menu\n              </h3>\n              <p class=\"text-xs text-slate-400\">Fixed prices for surviving back-to-back lectures</p>\n            </div>\n            <span class=\"text-xs font-bold text-amber-300 bg-amber-400/10 px-3 py-1 rounded-full border border-amber-400/20\">\n              UPI Accepted 📱\n            </span>\n          </div>\n\n          <div id=\"canteen-menu-grid\" class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\">\n            <!-- Sample Menu Items rendered by JS -->\n          </div>\n        </div>\n\n        <!-- Canteen Order / Bunk Cost Estimator -->\n        <div class=\"glass-card rounded-3xl p-6 border border-white/15 backdrop-blur-xl shadow-xl\">\n          <h4 class=\"font-heading font-black text-base text-white mb-2 flex items-center gap-2\">\n            <span>🧾</span> Canteen Bill & Bunk Calculator\n          </h4>\n          <p class=\"text-xs text-slate-300 mb-4\">\n            Pick your lecture survival snacks and calculate the damage to your pocket money.\n          </p>\n          <div id=\"canteen-calculator-items\" class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2\">\n            <!-- Checkbox snacks -->\n          </div>\n          <div class=\"mt-4 pt-3 border-t border-white/10 flex items-center justify-between\">\n            <span class=\"text-xs text-slate-300 font-bold\">Total Survival Damage:</span>\n            <span id=\"canteen-total-bill\" class=\"text-2xl font-black font-heading text-amber-400\">₹0</span>\n          </div>\n        </div>\n\n      </section>\n\n      <!-- ====================================================== -->\n      <!-- 📅 PAGE 5: TIMETABLE -->\n      <!-- ====================================================== -->\n      <section id=\"page-timetable\" class=\"page-section hidden space-y-6 animate-fade-in\">\n        \n        <!-- Header -->\n        <div class=\"glass-card rounded-3xl p-6 border border-white/15 backdrop-blur-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xl\">\n          <div>\n            <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/20 border border-cyan-400/30 text-cyan-300 text-xs font-bold mb-2\">\n              <span>Weekly Class Schedule</span>\n            </div>\n            <h2 class=\"text-2xl sm:text-3xl font-black font-heading text-white flex items-center gap-2\">\n              <span>📅</span> Weekly Timetable\n            </h2>\n            <p class=\"text-xs sm:text-sm text-slate-300 mt-1\">\n              Current day is highlighted automatically. Never miss attendance again!\n            </p>\n          </div>\n          <div class=\"flex items-center gap-2\">\n            <button onclick=\"App.openAddClassModal()\" class=\"py-2.5 px-4 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-xs shadow-lg shadow-cyan-600/30 transition flex items-center gap-1.5 active:scale-95\">\n              <span>➕</span> Add Class\n            </button>\n          </div>\n        </div>\n\n        <!-- Day Selector Tabs -->\n        <div class=\"flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none\">\n          <button onclick=\"App.selectTimetableDay('Monday')\" data-day=\"Monday\" class=\"timetable-day-btn px-4 py-2 rounded-xl text-xs font-bold transition flex-shrink-0\">\n            Monday\n          </button>\n          <button onclick=\"App.selectTimetableDay('Tuesday')\" data-day=\"Tuesday\" class=\"timetable-day-btn px-4 py-2 rounded-xl text-xs font-bold transition flex-shrink-0\">\n            Tuesday\n          </button>\n          <button onclick=\"App.selectTimetableDay('Wednesday')\" data-day=\"Wednesday\" class=\"timetable-day-btn px-4 py-2 rounded-xl text-xs font-bold transition flex-shrink-0\">\n            Wednesday\n          </button>\n          <button onclick=\"App.selectTimetableDay('Thursday')\" data-day=\"Thursday\" class=\"timetable-day-btn px-4 py-2 rounded-xl text-xs font-bold transition flex-shrink-0\">\n            Thursday\n          </button>\n          <button onclick=\"App.selectTimetableDay('Friday')\" data-day=\"Friday\" class=\"timetable-day-btn px-4 py-2 rounded-xl text-xs font-bold transition flex-shrink-0\">\n            Friday\n          </button>\n          <button onclick=\"App.selectTimetableDay('Saturday')\" data-day=\"Saturday\" class=\"timetable-day-btn px-4 py-2 rounded-xl text-xs font-bold transition flex-shrink-0\">\n            Saturday\n          </button>\n        </div>\n\n        <!-- Schedule Items for Selected Day -->\n        <div class=\"glass-card rounded-3xl p-6 border border-white/15 backdrop-blur-xl shadow-xl\">\n          <div class=\"flex items-center justify-between mb-4 pb-3 border-b border-white/10\">\n            <h3 id=\"timetable-selected-day-heading\" class=\"font-heading font-black text-lg text-white\">\n              Wednesday's Schedule\n            </h3>\n            <span id=\"timetable-classes-count\" class=\"text-xs text-indigo-300 font-bold\">5 Lectures</span>\n          </div>\n\n          <div id=\"timetable-day-list\" class=\"space-y-3\">\n            <!-- Classes rendered by JavaScript -->\n          </div>\n        </div>\n\n      </section>\n\n      <!-- ====================================================== -->\n      <!-- ⏳ PAGE 6: EXAM COUNTDOWN -->\n      <!-- ====================================================== -->\n      <section id=\"page-exams\" class=\"page-section hidden space-y-6 animate-fade-in\">\n        \n        <!-- Header -->\n        <div class=\"glass-card rounded-3xl p-6 border border-white/15 backdrop-blur-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xl\">\n          <div>\n            <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/20 border border-purple-400/30 text-purple-300 text-xs font-bold mb-2\">\n              <span>Live Ticking Clocks • Days, Hours, Mins, Secs</span>\n            </div>\n            <h2 class=\"text-2xl sm:text-3xl font-black font-heading text-white flex items-center gap-2\">\n              <span>⏳</span> Exam Countdown\n            </h2>\n            <p class=\"text-xs sm:text-sm text-slate-300 mt-1\">\n              Real-time countdown ticking down every second. Academic comeback begins now! 🔥\n            </p>\n          </div>\n          <div class=\"flex items-center gap-2\">\n            <button onclick=\"App.openAddExamModal()\" class=\"py-2.5 px-4 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs shadow-lg shadow-purple-600/30 transition flex items-center gap-1.5 active:scale-95\">\n              <span>➕</span> Add Exam\n            </button>\n          </div>\n        </div>\n\n        <!-- Exams Countdown Cards List -->\n        <div id=\"exams-container\" class=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n          <!-- Populated by JavaScript with live tickers -->\n        </div>\n\n      </section>\n\n      <!-- ====================================================== -->\n      <!-- 😂 PAGE 7: SLEEP OR STUDY (DEDICATED FULL FEATURE VIEW) -->\n      <!-- ====================================================== -->\n      <section id=\"page-sleep\" class=\"page-section hidden space-y-6 animate-fade-in\">\n        \n        <div class=\"max-w-2xl mx-auto glass-card rounded-3xl p-6 sm:p-8 border-2 border-amber-400/30 backdrop-blur-xl shadow-2xl relative overflow-hidden\">\n          <div class=\"text-center mb-6\">\n            <span class=\"text-4xl p-3 rounded-2xl bg-amber-500/20 text-amber-300 inline-block mb-3\">😂</span>\n            <h2 class=\"text-2xl sm:text-3xl font-black font-heading text-white\">\n              Should I Sleep or Study?\n            </h2>\n            <p class=\"text-xs sm:text-sm text-indigo-200 mt-1\">\n              Collegiate Neural Diagnostic Engine for Exhausted Students\n            </p>\n          </div>\n\n          <!-- Diagnostic Inputs -->\n          <div class=\"space-y-5 bg-white/5 p-5 rounded-2xl border border-white/10\">\n            <div>\n              <div class=\"flex justify-between text-xs font-bold text-slate-300 mb-1\">\n                <span>😴 Hours of sleep last night:</span>\n                <span id=\"sleep-hours-val\" class=\"text-amber-400 font-mono\">4 Hours</span>\n              </div>\n              <input type=\"range\" id=\"sleep-hours-slider\" min=\"0\" max=\"12\" value=\"4\" oninput=\"App.updateSleepHoursVal()\"\n                class=\"w-full accent-amber-500 bg-slate-800 rounded-lg cursor-pointer\">\n              <div class=\"flex justify-between text-[10px] text-slate-400 mt-1 font-mono\">\n                <span>0h (Zombie)</span>\n                <span>6h (Normal)</span>\n                <span>12h (Hibernation)</span>\n              </div>\n            </div>\n\n            <div>\n              <div class=\"flex justify-between text-xs font-bold text-slate-300 mb-1\">\n                <span>📚 Pending syllabus / assignment urgency:</span>\n                <span id=\"sleep-syllabus-val\" class=\"text-rose-400 font-mono\">70% Pending</span>\n              </div>\n              <input type=\"range\" id=\"sleep-syllabus-slider\" min=\"0\" max=\"100\" value=\"70\" oninput=\"App.updateSleepSyllabusVal()\"\n                class=\"w-full accent-rose-500 bg-slate-800 rounded-lg cursor-pointer\">\n              <div class=\"flex justify-between text-[10px] text-slate-400 mt-1 font-mono\">\n                <span>0% (Prepared)</span>\n                <span>50% (Sweating)</span>\n                <span>100% (God Help Me)</span>\n              </div>\n            </div>\n\n            <div>\n              <label class=\"block text-xs font-bold text-slate-300 mb-2\">🧠 Current Brain Status:</label>\n              <div class=\"grid grid-cols-2 sm:grid-cols-4 gap-2\">\n                <button type=\"button\" onclick=\"App.selectBrainStatus('zombie')\" data-brain=\"zombie\" class=\"brain-btn active p-2.5 rounded-xl border border-white/15 bg-white/10 text-center text-xs font-bold text-white hover:bg-white/20 transition\">\n                  🧟 Zombie\n                </button>\n                <button type=\"button\" onclick=\"App.selectBrainStatus('drowsy')\" data-brain=\"drowsy\" class=\"brain-btn p-2.5 rounded-xl border border-white/15 bg-white/5 text-center text-xs font-bold text-slate-300 hover:bg-white/20 transition\">\n                  🥱 Drowsy\n                </button>\n                <button type=\"button\" onclick=\"App.selectBrainStatus('normal')\" data-brain=\"normal\" class=\"brain-btn p-2.5 rounded-xl border border-white/15 bg-white/5 text-center text-xs font-bold text-slate-300 hover:bg-white/20 transition\">\n                  🙂 OK\n                </button>\n                <button type=\"button\" onclick=\"App.selectBrainStatus('caffeinated')\" data-brain=\"caffeinated\" class=\"brain-btn p-2.5 rounded-xl border border-white/15 bg-white/5 text-center text-xs font-bold text-slate-300 hover:bg-white/20 transition\">\n                  ⚡ Caffeinated\n                </button>\n              </div>\n            </div>\n          </div>\n\n          <!-- Submit Button -->\n          <div class=\"mt-6\">\n            <button onclick=\"App.askSurvivalAI()\" class=\"w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-amber-500 via-rose-500 to-indigo-600 hover:from-amber-400 hover:to-indigo-500 text-white font-black text-sm shadow-xl shadow-amber-500/20 active:scale-[0.98] transition flex items-center justify-center gap-2\">\n              <span>😂 ASK THE SURVIVAL AI</span>\n            </button>\n          </div>\n\n          <!-- Dynamic Result Display -->\n          <div id=\"sleep-result-container\" class=\"hidden mt-6 p-5 rounded-2xl border-2 text-center animate-fade-in\">\n            <div id=\"sleep-result-badge\" class=\"inline-block px-3 py-1 rounded-full text-xs font-black uppercase mb-2\"></div>\n            <div id=\"sleep-result-title\" class=\"text-xl sm:text-2xl font-black font-heading text-white\"></div>\n            <p id=\"sleep-result-desc\" class=\"text-xs sm:text-sm text-slate-200 mt-2 font-medium leading-relaxed\"></p>\n\n            <!-- 20-Minute Power Nap Option -->\n            <div id=\"nap-timer-widget\" class=\"hidden mt-4 pt-4 border-t border-white/10 flex flex-col items-center\">\n              <span class=\"text-xs text-indigo-300 font-bold mb-2\">⏱️ 20-Minute Emergency Power Nap Timer</span>\n              <div id=\"nap-time-display\" class=\"text-2xl font-mono font-black text-amber-300\">20:00</div>\n              <div class=\"flex items-center gap-2 mt-2\">\n                <button onclick=\"App.startNapTimer()\" id=\"nap-start-btn\" class=\"px-3 py-1 rounded-lg text-xs font-bold bg-indigo-600 hover:bg-indigo-500 text-white\">Start Nap 😴</button>\n                <button onclick=\"App.resetNapTimer()\" class=\"px-3 py-1 rounded-lg text-xs font-bold bg-white/10 hover:bg-white/20 text-slate-300\">Reset</button>\n              </div>\n            </div>\n          </div>\n\n        </div>\n\n      </section>\n\n    </main>\n\n    <!-- ======================================================== -->\n    <!-- FOOTER (App Name & Required Taglines) -->\n    <!-- ======================================================== -->\n    <footer class=\"mt-auto border-t border-white/10 bg-slate-950/80 backdrop-blur-xl py-6 px-4 text-center text-xs text-slate-400\">\n      <div class=\"max-w-7xl mx-auto flex flex-col items-center justify-center gap-2\">\n        <div class=\"flex items-center gap-2 text-white font-extrabold font-heading text-sm\">\n          <span>🎓</span> Student Survival App 🧑🎓🔥\n        </div>\n        <p class=\"text-indigo-300 font-semibold\">\n          “Made by students, for students ❤️”\n        </p>\n        <p class=\"text-amber-300 font-bold\">\n          “Now go study... or at least pretend to. 😂”\n        </p>\n        <p class=\"text-[11px] text-slate-500 mt-1\">\n          Survive college. One deadline at a time. • Powered by Pure Caffeine ☕\n        </p>\n      </div>\n    </footer>\n\n    <!-- ======================================================== -->\n    <!-- 📱 9. MOBILE BOTTOM NAVIGATION (Touch-friendly & sleek) -->\n    <!-- ======================================================== -->\n    <nav class=\"md:hidden fixed bottom-0 left-0 right-0 z-30 glass-nav border-t border-white/10 backdrop-blur-2xl px-2 py-1.5 flex items-center justify-around shadow-2xl\">\n      <button onclick=\"App.navigate('home')\" data-tab=\"home\" class=\"mobile-nav-btn active flex flex-col items-center py-1 px-2.5 rounded-xl transition text-[10px] font-bold\">\n        <span class=\"text-lg\">🏠</span>\n        <span>Home</span>\n      </button>\n\n      <button onclick=\"App.navigate('attendance')\" data-tab=\"attendance\" class=\"mobile-nav-btn flex flex-col items-center py-1 px-2.5 rounded-xl transition text-[10px] font-bold\">\n        <span class=\"text-lg\">📊</span>\n        <span>Attend</span>\n      </button>\n\n      <button onclick=\"App.navigate('assignments')\" data-tab=\"assignments\" class=\"mobile-nav-btn flex flex-col items-center py-1 px-2.5 rounded-xl transition text-[10px] font-bold relative\">\n        <span class=\"text-lg\">📝</span>\n        <span>Tasks</span>\n        <span id=\"mobile-badge-tasks\" class=\"absolute top-0 right-1 w-2 h-2 rounded-full bg-rose-500 ring-2 ring-slate-900\"></span>\n      </button>\n\n      <button onclick=\"App.navigate('timetable')\" data-tab=\"timetable\" class=\"mobile-nav-btn flex flex-col items-center py-1 px-2.5 rounded-xl transition text-[10px] font-bold\">\n        <span class=\"text-lg\">📅</span>\n        <span>Schedule</span>\n      </button>\n\n      <button onclick=\"App.navigate('exams')\" data-tab=\"exams\" class=\"mobile-nav-btn flex flex-col items-center py-1 px-2.5 rounded-xl transition text-[10px] font-bold\">\n        <span class=\"text-lg\">⏳</span>\n        <span>Exams</span>\n      </button>\n    </nav>\n\n  </div>\n\n  <!-- ======================================================== -->\n  <!-- MODALS -->\n  <!-- ======================================================== -->\n\n  <!-- MODAL: ADD / EDIT SUBJECT -->\n  <div id=\"modal-subject\" class=\"fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm\">\n    <div class=\"w-full max-w-md glass-card rounded-3xl p-6 border border-white/20 text-white shadow-2xl animate-fade-in\">\n      <div class=\"flex items-center justify-between mb-4\">\n        <h3 id=\"modal-subject-title\" class=\"text-lg font-black font-heading text-white\">➕ Add Subject</h3>\n        <button onclick=\"App.closeModal('modal-subject')\" class=\"p-1 rounded-lg text-slate-400 hover:text-white\">&times;</button>\n      </div>\n      <form id=\"form-subject\" onsubmit=\"App.saveSubject(event)\" class=\"space-y-4\">\n        <input type=\"hidden\" id=\"sub-id\">\n        <div>\n          <label class=\"block text-xs font-bold text-slate-300 mb-1\">Subject Name & Code</label>\n          <input type=\"text\" id=\"sub-name\" placeholder=\"e.g. DBMS (CS301)\" required\n            class=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/20 text-sm font-bold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n        </div>\n        <div class=\"grid grid-cols-2 gap-3\">\n          <div>\n            <label class=\"block text-xs font-bold text-slate-300 mb-1\">Total Classes</label>\n            <input type=\"number\" id=\"sub-total\" min=\"1\" value=\"40\" required\n              class=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/20 text-sm font-bold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n          </div>\n          <div>\n            <label class=\"block text-xs font-bold text-slate-300 mb-1\">Attended Classes</label>\n            <input type=\"number\" id=\"sub-attended\" min=\"0\" value=\"32\" required\n              class=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/20 text-sm font-bold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n          </div>\n        </div>\n        <div class=\"flex items-center justify-end gap-2 pt-2\">\n          <button type=\"button\" onclick=\"App.closeModal('modal-subject')\" class=\"px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 text-xs font-bold text-slate-300\">Cancel</button>\n          <button type=\"submit\" class=\"px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-xs font-bold text-white shadow-lg\">Save Subject</button>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <!-- MODAL: ADD / EDIT ASSIGNMENT -->\n  <div id=\"modal-assignment\" class=\"fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm\">\n    <div class=\"w-full max-w-md glass-card rounded-3xl p-6 border border-white/20 text-white shadow-2xl animate-fade-in\">\n      <div class=\"flex items-center justify-between mb-4\">\n        <h3 id=\"modal-assign-title\" class=\"text-lg font-black font-heading text-white\">➕ Add Assignment</h3>\n        <button onclick=\"App.closeModal('modal-assignment')\" class=\"p-1 rounded-lg text-slate-400 hover:text-white\">&times;</button>\n      </div>\n      <form id=\"form-assignment\" onsubmit=\"App.saveAssignment(event)\" class=\"space-y-3.5\">\n        <input type=\"hidden\" id=\"assign-id\">\n        <div>\n          <label class=\"block text-xs font-bold text-slate-300 mb-1\">Assignment Title</label>\n          <input type=\"text\" id=\"assign-title\" placeholder=\"e.g. Normalization & ER Model\" required\n            class=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/20 text-sm font-bold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n        </div>\n        <div>\n          <label class=\"block text-xs font-bold text-slate-300 mb-1\">Subject</label>\n          <select id=\"assign-subject\" class=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/20 text-sm font-bold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n            <option value=\"DBMS\">DBMS</option>\n            <option value=\"Data Structures (DS)\">Data Structures (DS)</option>\n            <option value=\"Digital System Design (DSD)\">Digital System Design (DSD)</option>\n            <option value=\"Value Added Course (VAC)\">Value Added Course (VAC)</option>\n            <option value=\"OOP / Java\">OOP / Java</option>\n            <option value=\"Computer Organization & Architecture (COA)\">Computer Organization & Architecture (COA)</option>\n          </select>\n        </div>\n        <div class=\"grid grid-cols-2 gap-3\">\n          <div>\n            <label class=\"block text-xs font-bold text-slate-300 mb-1\">Due Date</label>\n            <input type=\"date\" id=\"assign-date\" required\n              class=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/20 text-sm font-bold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n          </div>\n          <div>\n            <label class=\"block text-xs font-bold text-slate-300 mb-1\">Priority</label>\n            <select id=\"assign-priority\" class=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/20 text-sm font-bold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n              <option value=\"High\">🔥 High / Urgent</option>\n              <option value=\"Medium\" selected>⚠️ Medium</option>\n              <option value=\"Low\">🟢 Low</option>\n            </select>\n          </div>\n        </div>\n        <div class=\"flex items-center justify-end gap-2 pt-2\">\n          <button type=\"button\" onclick=\"App.closeModal('modal-assignment')\" class=\"px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 text-xs font-bold text-slate-300\">Cancel</button>\n          <button type=\"submit\" class=\"px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-500 text-xs font-bold text-white shadow-lg\">Save Assignment</button>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <!-- MODAL: ADD / EDIT CLASS (TIMETABLE) -->\n  <div id=\"modal-class\" class=\"fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm\">\n    <div class=\"w-full max-w-md glass-card rounded-3xl p-6 border border-white/20 text-white shadow-2xl animate-fade-in\">\n      <div class=\"flex items-center justify-between mb-4\">\n        <h3 id=\"modal-class-title\" class=\"text-lg font-black font-heading text-white\">➕ Add Class</h3>\n        <button onclick=\"App.closeModal('modal-class')\" class=\"p-1 rounded-lg text-slate-400 hover:text-white\">&times;</button>\n      </div>\n      <form id=\"form-class\" onsubmit=\"App.saveClass(event)\" class=\"space-y-3.5\">\n        <input type=\"hidden\" id=\"class-id\">\n        <div class=\"grid grid-cols-2 gap-3\">\n          <div>\n            <label class=\"block text-xs font-bold text-slate-300 mb-1\">Day</label>\n            <select id=\"class-day\" class=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/20 text-sm font-bold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n              <option value=\"Monday\">Monday</option>\n              <option value=\"Tuesday\">Tuesday</option>\n              <option value=\"Wednesday\">Wednesday</option>\n              <option value=\"Thursday\">Thursday</option>\n              <option value=\"Friday\">Friday</option>\n              <option value=\"Saturday\">Saturday</option>\n            </select>\n          </div>\n          <div>\n            <label class=\"block text-xs font-bold text-slate-300 mb-1\">Time Slot</label>\n            <input type=\"text\" id=\"class-time\" placeholder=\"e.g. 09:00 - 10:00\" required\n              class=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/20 text-sm font-bold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n          </div>\n        </div>\n        <div>\n          <label class=\"block text-xs font-bold text-slate-300 mb-1\">Subject</label>\n          <input type=\"text\" id=\"class-subject\" placeholder=\"e.g. DBMS Lecture\" required\n            class=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/20 text-sm font-bold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n        </div>\n        <div class=\"grid grid-cols-2 gap-3\">\n          <div>\n            <label class=\"block text-xs font-bold text-slate-300 mb-1\">Room / Hall</label>\n            <input type=\"text\" id=\"class-room\" placeholder=\"e.g. Room 302\" required\n              class=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/20 text-sm font-bold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n          </div>\n          <div>\n            <label class=\"block text-xs font-bold text-slate-300 mb-1\">Professor</label>\n            <input type=\"text\" id=\"class-faculty\" placeholder=\"e.g. Dr. Verma\"\n              class=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/20 text-sm font-bold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n          </div>\n        </div>\n        <div class=\"flex items-center justify-end gap-2 pt-2\">\n          <button type=\"button\" onclick=\"App.closeModal('modal-class')\" class=\"px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 text-xs font-bold text-slate-300\">Cancel</button>\n          <button type=\"submit\" class=\"px-5 py-2 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-xs font-bold text-white shadow-lg\">Save Class</button>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <!-- MODAL: ADD / EDIT EXAM -->\n  <div id=\"modal-exam\" class=\"fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm\">\n    <div class=\"w-full max-w-md glass-card rounded-3xl p-6 border border-white/20 text-white shadow-2xl animate-fade-in\">\n      <div class=\"flex items-center justify-between mb-4\">\n        <h3 id=\"modal-exam-title\" class=\"text-lg font-black font-heading text-white\">➕ Add Exam</h3>\n        <button onclick=\"App.closeModal('modal-exam')\" class=\"p-1 rounded-lg text-slate-400 hover:text-white\">&times;</button>\n      </div>\n      <form id=\"form-exam\" onsubmit=\"App.saveExam(event)\" class=\"space-y-3.5\">\n        <input type=\"hidden\" id=\"exam-id\">\n        <div>\n          <label class=\"block text-xs font-bold text-slate-300 mb-1\">Subject Name</label>\n          <select id=\"exam-subject\" class=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/20 text-sm font-bold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n            <option value=\"DBMS\">DBMS</option>\n            <option value=\"Data Structures (DS)\">Data Structures (DS)</option>\n            <option value=\"Digital System Design (DSD)\">Digital System Design (DSD)</option>\n            <option value=\"Value Added Course (VAC)\">Value Added Course (VAC)</option>\n            <option value=\"OOP / Java\">OOP / Java</option>\n            <option value=\"Computer Organization & Architecture (COA)\">Computer Organization & Architecture (COA)</option>\n          </select>\n        </div>\n        <div class=\"grid grid-cols-2 gap-3\">\n          <div>\n            <label class=\"block text-xs font-bold text-slate-300 mb-1\">Exam Date</label>\n            <input type=\"date\" id=\"exam-date\" required\n              class=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/20 text-sm font-bold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n          </div>\n          <div>\n            <label class=\"block text-xs font-bold text-slate-300 mb-1\">Exam Time</label>\n            <input type=\"time\" id=\"exam-time\" value=\"10:00\" required\n              class=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/20 text-sm font-bold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n          </div>\n        </div>\n        <div>\n          <label class=\"block text-xs font-bold text-slate-300 mb-1\">Exam Hall / Room</label>\n          <input type=\"text\" id=\"exam-hall\" placeholder=\"e.g. Main Auditorium Hall B\" required\n            class=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/20 text-sm font-bold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n        </div>\n        <div class=\"flex items-center justify-end gap-2 pt-2\">\n          <button type=\"button\" onclick=\"App.closeModal('modal-exam')\" class=\"px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 text-xs font-bold text-slate-300\">Cancel</button>\n          <button type=\"submit\" class=\"px-5 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-xs font-bold text-white shadow-lg\">Save Exam</button>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <!-- MODAL: 12. PROFILE / SETTINGS & LOGOUT -->\n  <div id=\"modal-profile\" class=\"fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm\">\n    <div class=\"w-full max-w-md glass-card rounded-3xl p-6 sm:p-7 border border-white/20 text-white shadow-2xl animate-fade-in relative\">\n      <div class=\"flex items-center justify-between mb-4 pb-3 border-b border-white/10\">\n        <h3 class=\"text-lg font-black font-heading text-white flex items-center gap-2\">\n          <span>👤</span> Student Profile\n        </h3>\n        <button onclick=\"App.closeModal('modal-profile')\" class=\"p-1 rounded-lg text-slate-400 hover:text-white\">&times;</button>\n      </div>\n\n      <div class=\"flex items-center gap-4 mb-5 p-3 rounded-2xl bg-white/5 border border-white/10\">\n        <div class=\"w-14 h-14 rounded-2xl overflow-hidden border-2 border-indigo-400 shadow flex-shrink-0\">\n          <img src=\"assets/life-of-a-student.jpg\" alt=\"Profile Avatar\" class=\"w-full h-full object-cover\">\n        </div>\n        <div>\n          <h4 id=\"prof-display-name\" class=\"font-heading font-black text-base text-white\">Aarav Sharma</h4>\n          <p id=\"prof-display-email\" class=\"text-xs text-indigo-300 font-mono\">aarav@college.edu</p>\n          <span class=\"inline-block mt-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-400/20 text-amber-300 border border-amber-400/30\">\n            Computer Science • Sem 4\n          </span>\n        </div>\n      </div>\n\n      <!-- Quick Edit Profile -->\n      <form onsubmit=\"App.updateProfile(event)\" class=\"space-y-3 mb-5\">\n        <div>\n          <label class=\"block text-xs font-bold text-slate-300 mb-1\">Student Name</label>\n          <input type=\"text\" id=\"prof-input-name\" required\n            class=\"w-full px-3 py-2 rounded-xl bg-slate-900/80 border border-white/20 text-sm font-semibold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n        </div>\n        <div>\n          <label class=\"block text-xs font-bold text-slate-300 mb-1\">Email</label>\n          <input type=\"email\" id=\"prof-input-email\" required\n            class=\"w-full px-3 py-2 rounded-xl bg-slate-900/80 border border-white/20 text-sm font-semibold text-white focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n        </div>\n        <button type=\"submit\" class=\"w-full py-2 px-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs shadow transition\">\n          ✏️ Save Profile Updates\n        </button>\n      </form>\n\n      <!-- App Utility Actions -->\n      <div class=\"pt-3 border-t border-white/10 space-y-2\">\n        <button onclick=\"App.resetToSampleData()\" class=\"w-full py-2 px-3 rounded-xl bg-white/10 hover:bg-white/15 text-slate-300 text-xs font-bold transition flex items-center justify-center gap-2\">\n          <span>🔄</span> Reset to Realistic Sample College Data\n        </button>\n\n        <button onclick=\"App.promptLogout()\" class=\"w-full py-2.5 px-3 rounded-xl bg-rose-600/30 hover:bg-rose-600/50 border border-rose-500/40 text-rose-200 font-bold text-xs transition flex items-center justify-center gap-2\">\n          <span>🚪</span> Logout of Survival Mode\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <!-- MODAL: 12. LOGOUT CONFIRMATION DIALOG -->\n  <div id=\"modal-logout-confirm\" class=\"fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/80 backdrop-blur-md\">\n    <div class=\"w-full max-w-sm glass-card rounded-3xl p-6 border-2 border-rose-500/40 text-white shadow-2xl text-center animate-fade-in\">\n      <div class=\"w-16 h-16 rounded-2xl overflow-hidden border-2 border-rose-400 mx-auto mb-3 shadow-xl\">\n        <img src=\"assets/life-of-a-student.jpg\" alt=\"Life of a Student Logo\" class=\"w-full h-full object-cover\">\n      </div>\n      <h3 class=\"text-lg font-black font-heading text-white\">\n        Are you sure you want to escape Survival Mode? 😂\n      </h3>\n      <p class=\"text-xs text-slate-300 mt-2\">\n        Your assignments will miss you, and the canteen samosas might get cold.\n      </p>\n\n      <div class=\"grid grid-cols-2 gap-3 mt-6\">\n        <button onclick=\"App.closeModal('modal-logout-confirm')\" class=\"py-2.5 px-4 rounded-xl bg-white/15 hover:bg-white/20 font-bold text-xs text-white transition\">\n          Stay 😭\n        </button>\n        <button onclick=\"App.confirmLogout()\" class=\"py-2.5 px-4 rounded-xl bg-rose-600 hover:bg-rose-500 font-bold text-xs text-white shadow-lg shadow-rose-600/40 transition\">\n          Logout 🚪\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <!-- MODAL: SLEEP OR STUDY INTERACTIVE POPUP -->\n  <div id=\"modal-sleep-quick\" class=\"fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/80 backdrop-blur-md\">\n    <div class=\"w-full max-w-md glass-card rounded-3xl p-6 sm:p-7 border-2 border-amber-400/50 text-white shadow-2xl text-center animate-bounce-subtle\">\n      <span class=\"text-4xl inline-block mb-2\">😂</span>\n      <h3 class=\"text-xl font-black font-heading text-white\">Survival AI Verdict</h3>\n      \n      <div class=\"my-5 p-4 rounded-2xl bg-white/10 border border-white/20\">\n        <div id=\"quick-sleep-verdict-title\" class=\"text-lg font-black text-amber-300\">📚 STUDY!</div>\n        <p id=\"quick-sleep-verdict-text\" class=\"text-xs sm:text-sm text-slate-200 mt-2 font-semibold leading-relaxed\">\n          “Your exam is closer than you think.”\n        </p>\n      </div>\n\n      <div class=\"flex items-center justify-center gap-3\">\n        <button onclick=\"App.askSleepOrStudyQuick()\" class=\"py-2 px-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-900 font-extrabold text-xs transition flex items-center gap-1\">\n          <span>🎲</span> Ask Again\n        </button>\n        <button onclick=\"App.closeModal('modal-sleep-quick')\" class=\"py-2 px-4 rounded-xl bg-white/15 hover:bg-white/20 text-white font-bold text-xs transition\">\n          Got it 🫡\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <!-- Notification Toast Container -->\n  <div id=\"toast-container\" class=\"fixed top-5 right-5 z-50 space-y-2 pointer-events-none\"></div>\n\n  <!-- JavaScript Application Logic -->\n  <script src=\"app.js\"></script>\n</body>\n</html>\n","Description":"Create complete semantic, responsive, mobile-first index.html with uploaded image integration, loading screen, login page, dashboard, attendance, assignments, canteen, timetable, exams, and sleep/study feature.","Overwrite":true,"TargetFile":"C:\\Users\\DELL\\.gemini\\antigravity\\scratch\\student-survival-app\\index.html","toolAction":"Writing index.html","toolSummary":"Create index.html for Student Survival App"}}]}
