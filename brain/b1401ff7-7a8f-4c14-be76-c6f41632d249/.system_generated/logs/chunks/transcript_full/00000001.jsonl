fe-of-a-student.jpg\" \"C:\\Users\\DELL\\OneDrive\\Desktop\\student survival\\student-survival-app\\assets\\logo.jpg\"\nTest-Path \"C:\\Users\\DELL\\OneDrive\\Desktop\\student survival\\student-survival-app\\assets\\life-of-a-student.jpg\"\n","Cwd":"C:\\Users\\DELL\\.gemini\\antigravity\\scratch","WaitMsBeforeAsync":5000,"toolAction":"Copying assets to desktop folder","toolSummary":"Ensure asset in desktop app folder"}}]}
