: 32, attended: 22 }, // 68.75% - Warning (need 8)\n36:     { id: 'sub-4', name: 'Value Added Course (VAC)', total: 20, attended: 18 },    // 90.0% - Safe (can miss 4)\n37:     { id: 'sub-5', name: 'OOP / Java', total: 42, attended: 36 },           // 85.7% - Safe (can miss 6)\n38:     { id: 'sub-6', name: 'COA (CS304)', total: 35, attended: 21 },         // 60.0% - Danger (need 21)\n39:   ];\n40: \n41:   // Helper to generate dates relative to today\n42:   function getFutureDate(daysAhead, hours = 23, mins = 59) {\n43:     const d = new Date();\n44:     d.setDate(d.getDate() + daysAhead);\n45:     d.setHours(hours, mins, 0, 0);\n46:     return d.toISOString();\n47:   }\n48: \n49:   const DEFAULT_ASSIGNMENTS = [\n50:     {\n51:       id: 'asg-1',\n52:       title: 'DBMS Normalization & ER Diagram Project',\n53:       subject: 'DBMS',\n54:       dueDate: getFutureDate(2, 23, 59), // 2 days left\n55:       priority: 'High',\n56:       completed: false,\n57:     },\n58:     {\n59:       id: 'asg-2',\n60:       title: 'Red-Black Trees & Heap Sort Implementation',\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
