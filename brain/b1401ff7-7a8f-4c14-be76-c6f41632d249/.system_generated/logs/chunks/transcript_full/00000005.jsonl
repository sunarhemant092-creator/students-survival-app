ition flex items-center gap-1.5 py-1 px-3 rounded-lg hover:bg-white/10\">\n101:         <span>Skip to App</span> &rarr;\n102:       </button>\n103:     </div>\n104:   </div>\n105: \n106:   <!-- ======================================================== -->\n107:   <!-- 🔐 1. LOGIN / WELCOME PAGE (Glassmorphism Card) -->\n108:   <!-- ======================================================== -->\n109:   <div id=\"auth-screen\" class=\"fixed inset-0 z-40 hidden flex items-center justify-center p-4 overflow-y-auto\">\n110:     <div class=\"w-full max-w-md glass-card rounded-3xl p-6 sm:p-8 backdrop-blur-2xl shadow-2xl border border-white/20 text-white my-auto animate-fade-in relative overflow-hidden\">\n111:       <!-- Glow accent behind card -->\n112:       <div class=\"absolute -top-20 -right-20 w-44 h-44 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none\"></div>\n113:       <div class=\"absolute -bottom-20 -left-20 w-44 h-44 bg-amber-500/20 rounded-full blur-3xl pointer-events-none\"></div>\n114: \n115:       <!-- Header with Logo -->\n116:       <div class=\"text-center mb-6\">\n117:         <div class=\"inline-block relative mb-3\">\n118:           <div class=\"w-20 h-20 rounded-2xl overflow-hidden border-2 border-indigo-400/50 shadow-xl mx-auto ring-4 ring-indigo-500/20\">\n119:             <img src=\"assets/life-of-a-student.jpg\" alt=\"Life of a Student Logo\" class=\"w-full h-full object-cover\">\n120:           </div>\n121:           <span class=\"absolute -bottom-1 -right-1 text-base\">🧑🎓</span>\n122:         </div>\n123:         <h2 class=\"text-2xl font-black font-heading tracking-tight text-white flex items-center justify-center gap-2\">\n124:           🎓 Student Survival App\n125:         </h2>\n126:         <p class=\"text-xs sm:text-sm text-indigo-200 font-medium mt-1\">\n127:           “Survive college. One deadline at a time. 😂”\n128:         </p>\n129:       </div>\n130: \n131:       <!-- Login Form -->\n132:       <form id=\"login-form\" onsubmi