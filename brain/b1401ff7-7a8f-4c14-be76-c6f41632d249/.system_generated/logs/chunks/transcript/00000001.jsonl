ll;\n243:   function getAudioContext() {\n244:     if (!audioCtx && (window.AudioContext || window.webkitAudioContext)) {\n245:       const AudioCtx = window.AudioContext || window.webkitAudioContext;\n246:       audioCtx = new AudioCtx();\n247:     }\n248:     if (audioCtx && audioCtx.state === 'suspended') {\n249:       audioCtx.resume();\n250:     }\n251:     return audioCtx;\n252:   }\n253: \n254:   function playSound(type) {\n255:     if (!state.student.soundEnabled) return;\n256:     try {\n257:       const ctx = getAudioContext();\n258:       if (!ctx) return;\n259: \n260:       const now = ctx.currentTime;\n261:       const osc = ctx.createOscillator();\n262:       const gain = ctx.createGain();\n263:       osc.connect(gain);\n264:       gain.connect(ctx.destination);\n265: \n266:       if (type === 'click') {\n267:         // Crisp subtle tap\n268:         osc.type = 'sine';\n269:         osc.frequency.setValueAtTime(600, now);\n270:         osc.frequency.exponentialRampToValueAtTime(300, now + 0.05);\n271:         gain.gain.setValueAtTime(0.15, now);\n272:         gain.gain.exponentialRampToValueAtTime(0.01, now + 0.05);\n273:         osc.start(now);\n274:         osc.stop(now + 0.05);\n275:       } else if (type === 'success') {\n276:         // High celebratory victory chime\n277:         osc.type = 'triangle';\n278:         osc.frequency.setValueAtTime(523.25, now); // C5\n279:         osc.frequency.setValueAtTime(659.25, now + 0.08); // E5\n280:         osc.frequency.setValueAtTime(783.99, now + 0.16); // G5\n281:         osc.frequency.setValueAtTime(1046.50, now + 0.24); // C6\n282:         gain.gain.setValueAtTime(0.2, now);\n283:         gain.gain.exponentialRampToValueAtTime(0.01, now + 0.45);\n284:         osc.start(now);\n285:         osc.stop(now + 0.45);\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
